# artifacts/mobile/.env.example
# Copy to artifacts/mobile/.env for local dev. Expo's tooling (unlike the
# api-server) DOES load .env files automatically for EXPO_PUBLIC_* vars —
# see https://docs.expo.dev/guides/environment-variables/. Only variables
# prefixed EXPO_PUBLIC_ are bundled into the client; anything else here is
# read only by the Node-side build/serve scripts, not the app itself.

# Base URL of the api-server, INCLUDING its /api mount prefix
# (see artifacts/api-server/src/app.ts — everything is mounted at /api).
# Read by lib/apiUrl.ts. If unset on web, it falls back to
# `${window.location.origin}/api-server`, which nothing actually serves
# unless a reverse proxy maps that path to the real api-server — this is
# the exact gap that broke the admin Translate button.
EXPO_PUBLIC_API_URL=https://your-api-server-host/api

# Deployment path prefix — read by server/serve.js and scripts/build.js.
# Leave unset for a normal root-path deployment.
BASE_PATH=

# The following are Replit-specific and auto-injected by that platform's
# environment (scripts/build.js) — do not set these by hand locally:
#   REPLIT_INTERNAL_APP_DOMAIN, REPLIT_DEV_DOMAIN, REPL_ID,
#   EXPO_PUBLIC_DOMAIN, EXPO_PUBLIC_REPL_ID

# Agora.io app ID (see hooks/useAgora.ts) — not sensitive, safe to bundle
# into the client. The matching AGORA_APP_CERTIFICATE stays server-side
# only (artifacts/api-server/.env.example) since it signs tokens.
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id
