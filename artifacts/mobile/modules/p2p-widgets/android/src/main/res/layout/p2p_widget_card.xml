<?xml version="1.0" encoding="utf-8"?>
<!-- One card layout shared by every P2P widget (filled in P2PWidgets.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/p2p_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="14dp"
  android:background="@drawable/p2p_widget_background">

  <TextView
    android:id="@+id/p2p_widget_kicker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="@color/p2p_widget_accent"
    android:textSize="11sp"
    android:textStyle="bold"
    android:letterSpacing="0.06"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/p2p_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="@color/p2p_widget_text"
    android:textSize="17sp"
    android:textStyle="bold"
    android:maxLines="2"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/p2p_widget_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="4dp"
    android:textColor="@color/p2p_widget_text"
    android:textSize="13sp"
    android:lineSpacingExtra="2dp"
    android:maxLines="5"
    android:ellipsize="end" />

  <ProgressBar
    android:id="@+id/p2p_widget_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="6dp"
    android:max="100"
    android:progressTint="@color/p2p_widget_accent"
    android:visibility="gone" />

  <TextView
    android:id="@+id/p2p_widget_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="@color/p2p_widget_muted"
    android:textSize="12sp"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/p2p_widget_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:textColor="@color/p2p_widget_accent"
    android:textSize="13sp"
    android:textStyle="bold"
    android:maxLines="1" />
</LinearLayout>
