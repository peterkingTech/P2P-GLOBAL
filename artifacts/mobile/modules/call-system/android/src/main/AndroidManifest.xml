<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Self-managed VoIP calls through Telecom (core-telecom also declares it). -->
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <!-- Incoming-call screen over the lock screen. On Android 14+ this is only
       granted to calling apps; without it the call still rings as a heads-up
       notification. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!-- Native incoming-call screen: shows over the lock screen and wakes it. -->
    <activity
      android:name=".IncomingCallActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:showWhenLocked="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Black.NoTitleBar"
      android:turnScreenOn="true"
      tools:targetApi="27" />

    <!-- "Call back" from the system call log (Android 16.1+ unified call
         history). Registering this action is what lets the dialer return a
         P2P call through P2P. -->
    <activity
      android:name=".CallBackActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.telecom.action.CALL_BACK" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <receiver
      android:name=".CallActionReceiver"
      android:exported="false" />

    <!-- Replaces expo-notifications' own FCM service (the config plugin
         removes that one from the app manifest); it handles incoming-call
         pushes natively and passes every other message straight to Expo. -->
    <service
      android:name=".P2PFirebaseMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
