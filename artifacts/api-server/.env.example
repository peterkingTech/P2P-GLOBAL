# artifacts/api-server/.env.example
# Copy to artifacts/api-server/.env and fill in real values. This file itself
# must never contain real secrets — it's committed as documentation only.
#
# IMPORTANT: nothing in this codebase calls dotenv.config() or loads .env
# automatically. Node's built-in `--env-file` flag (Node 20.6+) or your own
# shell export is what actually gets these into process.env, e.g.:
#   node --env-file=.env dist/index.js
# In deployed environments (Replit), these are injected directly via the
# Secrets panel — no .env file exists there at all.

# Required — server won't start without a valid PORT (see src/index.ts)
PORT=3000

# Supabase — all optional, each falls back to the hardcoded project values
# baked into src/lib/supabase.ts, src/lib/bibleService.ts,
# src/lib/translationEngine.ts, src/routes/translations.ts,
# src/middleware/adminAuth.ts if unset. Only override to point at a
# different Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_DB_URL overrides SUPABASE_URL when it starts with https:// —
# only one of the two is actually needed.
SUPABASE_DB_URL=

# Required for anything that writes as an admin: batch-translate,
# translateAndStore, retryJob (src/lib/translationEngine.ts,
# src/lib/bibleService.ts, src/routes/translations.ts). No fallback —
# defaults to "" and every admin-privileged Supabase call fails silently.
SUPABASE_SERVICE_ROLE_KEY=

# Bible verse lookups (src/routes/bible.ts, src/lib/bibleService.ts).
# Either name works — the code checks API_Bible first, then API_BIBLE_KEY.
API_BIBLE_KEY=

# AI translation engine (src/lib/translationEngine.ts) — required for any
# translation to run (translateAndStore, batchTranslateCurriculum, retryJob,
# and the translateCurriculum.ts batch script). Uses Anthropic's Claude Haiku
# 4.5 model. Get a key from https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Optional — logging (src/lib/logger.ts)
NODE_ENV=development
LOG_LEVEL=info
