{"data":{"id":"PSA.23","bibleId":"de4e12af7f28f599-01","number":"23","bookId":"PSA","reference":"Psalms 23","copyright":"PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent","verseCount":6,"content":[{"name":"para","type":"tag","attrs":{"style":"d"},"items":[{"text":"A Psalm of David.","type":"text"}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"The ","type":"text","attrs":{"verseId":"PSA.23.1","verseOrgIds":["PSA.23.1"]}},{"name":"char","type":"tag","attrs":{"style":"nd"},"items":[{"text":"LORD","type":"text","attrs":{"verseId":"PSA.23.1","verseOrgIds":["PSA.23.1"]}}]},{"text":" ","type":"text","attrs":{"verseId":"PSA.23.1","verseOrgIds":["PSA.23.1"]}},{"name":"char","type":"tag","attrs":{"style":"add"},"items":[{"text":"is","type":"text","attrs":{"verseId":"PSA.23.1","verseOrgIds":["PSA.23.1"]}}]},{"text":" my shepherd; I shall not want.","type":"text","attrs":{"verseId":"PSA.23.1","verseOrgIds":["PSA.23.1"]}}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"He maketh me to lie down in green pastures: he leadeth me beside the still waters.","type":"text","attrs":{"verseId":"PSA.23.2","verseOrgIds":["PSA.23.2"]}}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"He restoreth my soul: he leadeth me in the paths of righteousness for his name’s sake.","type":"text","attrs":{"verseId":"PSA.23.3","verseOrgIds":["PSA.23.3"]}}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou ","type":"text","attrs":{"verseId":"PSA.23.4","verseOrgIds":["PSA.23.4"]}},{"name":"char","type":"tag","attrs":{"style":"add"},"items":[{"text":"art","type":"text","attrs":{"verseId":"PSA.23.4","verseOrgIds":["PSA.23.4"]}}]},{"text":" with me; thy rod and thy staff they comfort me.","type":"text","attrs":{"verseId":"PSA.23.4","verseOrgIds":["PSA.23.4"]}}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over.","type":"text","attrs":{"verseId":"PSA.23.5","verseOrgIds":["PSA.23.5"]}}]},{"name":"para","type":"tag","attrs":{"style":"q1"},"items":[{"text":"Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the ","type":"text","attrs":{"verseId":"PSA.23.6","verseOrgIds":["PSA.23.6"]}},{"name":"char","type":"tag","attrs":{"style":"nd"},"items":[{"text":"LORD","type":"text","attrs":{"verseId":"PSA.23.6","verseOrgIds":["PSA.23.6"]}}]},{"text":" for ever.","type":"text","attrs":{"verseId":"PSA.23.6","verseOrgIds":["PSA.23.6"]}}]}],"next":{"id":"PSA.24","number":"24","bookId":"PSA"},"previous":{"id":"PSA.22","number":"22","bookId":"PSA"}}}