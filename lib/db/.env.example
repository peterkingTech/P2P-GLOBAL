# lib/db/.env.example
# Copy to lib/db/.env. Used by drizzle.config.ts (migrations tooling) and
# src/index.ts (the pool this package's queries run through).
#
# Note: this package's schema (src/schema/p2p.ts) has been observed to drift
# from the live database's actual columns — verify against the real DB
# before trusting a query built through this package, don't assume the
# schema file is current.
#
# Required — Supabase Transaction pooler connection string. Either name
# works; SUPABASE_DB_URL takes priority if both are set.
SUPABASE_DB_URL=
DATABASE_URL=
